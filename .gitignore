__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
.ruff_cache/

# ビルド成果物。`pip install .` がパッケージの複製を作るのでコミットしない
build/
dist/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# OS/System files
.DS_Store
Thumbs.db

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# データセット・実行成果物（ソースではない。ストレージ/Delta 側に置く）
# ルート直下のみ。persona_sim/data/ はパッケージ同梱の参照テーブル（国勢調査）なのでコミットする。
/data/
outputs/
*.parquet
*.duckdb

# ノートブックのローカル実行成果物（notebooks/quickstart.ipynb が作る）
notebooks/_quickstart/
notebooks/.ipynb_checkpoints/
